# Copy this file to `keystore.properties` and fill in your own values.
# This file is gitignored — never commit real credentials.
#
# `storeFile` is resolved relative to the `app/` module, so `../release.keystore`
# points at a keystore placed in the project root.
#
# The same values can be supplied as environment variables instead:
#   KEYSTORE_FILE, KEYSTORE_STORE_PASSWORD, KEYSTORE_KEY_ALIAS, KEYSTORE_KEY_PASSWORD

storeFile=../release.keystore
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=push-to-finance
keyPassword=CHANGE_ME_KEY_PASSWORD